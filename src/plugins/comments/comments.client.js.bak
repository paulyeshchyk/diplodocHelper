(function () {
  'use strict';
  if (typeof window === 'undefined') return;

  const cfg = window.__DL_COMMENTS_CFG__ || {};
  const ui = cfg.ui || {};
  const API = (cfg.apiBase || '/api').replace(/\/+$/, '');
  const LANG = cfg.lang || 'ru';
  const PANEL_WIDTH = 360;

  // ---------- DOM helpers ----------
  function findArticleBody() {
    return document.querySelector('.dc-doc-page__body')
      || document.querySelector('.dc-doc-page__content')
      || document.querySelector('.dc-doc-page__main');
  }
  function getRoot() {
    return findArticleBody() || document.querySelector('main') || document.body;
  }
  function textOffset(root, node, offset) {
    if (!root || !node) return -1;
    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
    let total = 0, cur;
    while ((cur = w.nextNode())) {
      if (cur === node) return total + offset;
      total += cur.textContent.length;
    }
    return -1;
  }
  function nodeAtOffset(root, offset) {
    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
    let total = 0, cur;
    while ((cur = w.nextNode())) {
      const len = cur.textContent.length;
      if (total + len > offset) return { node: cur, offset: offset - total };
      total += len;
    }
    return null;
  }
  function rangeFromOffsets(root, start, end) {
    const a = nodeAtOffset(root, start);
    const b = nodeAtOffset(root, end);
    if (!a || !b) return null;
    const r = document.createRange();
    try { r.setStart(a.node, a.offset); r.setEnd(b.node, b.offset); } catch { return null; }
    return r;
  }
  function offsetFromPoint(x, y) {
    let r = null;
    if (document.caretRangeFromPoint) r = document.caretRangeFromPoint(x, y);
    else if (document.caretPositionFromPoint) {
      const p = document.caretPositionFromPoint(x, y);
      if (p) { r = document.createRange(); try { r.setStart(p.offsetNode, p.offset); r.collapse(true); } catch { return null; } }
    }
    if (!r) return null;
    const root = getRoot();
    if (!root.contains(r.startContainer)) return null;
    const o = textOffset(root, r.startContainer, r.startOffset);
    return o >= 0 ? o : null;
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  // ---------- anchor ----------
  function buildAnchor(range) {
    const root = getRoot();
    const start = textOffset(root, range.startContainer, range.startOffset);
    const end = textOffset(root, range.endContainer, range.endOffset);
    if (start < 0 || end <= start) return null;
    const all = root.textContent;
    return {
      quote: all.slice(start, end),
      prefix: all.slice(Math.max(0, start - 50), start),
      suffix: all.slice(end, end + 50),
      startOffset: start, endOffset: end, xpath: null,
    };
  }
  function findAnchorPositions(root, anchor) {
    const text = root.textContent;
    if (anchor.startOffset != null && anchor.endOffset != null
      && text.slice(anchor.startOffset, anchor.endOffset) === anchor.quote) {
      return { start: anchor.startOffset, end: anchor.endOffset };
    }
    const combined = (anchor.prefix || '') + anchor.quote + (anchor.suffix || '');
    let idx = text.indexOf(combined);
    if (idx !== -1) {
      const start = idx + (anchor.prefix || '').length;
      return { start, end: start + anchor.quote.length };
    }
    idx = text.indexOf(anchor.quote);
    if (idx !== -1) return { start: idx, end: idx + anchor.quote.length };
    return null;
  }

  // ---------- local hide (архив читателя) ----------
  function getHiddenSet() {
    try { return new Set(JSON.parse(localStorage.getItem('dl-comments-hidden') || '[]')); }
    catch { return new Set(); }
  }
  function hideThreadLocal(id) {
    const s = getHiddenSet(); s.add(id);
    try { localStorage.setItem('dl-comments-hidden', JSON.stringify([...s])); } catch { }
  }

  // ---------- state ----------
  const state = {
    threads: [],
    segments: [],
    popup: null,
    panel: null,
    panelThreadIds: null,   // ← какие треды сейчас в панели (для rerender)
    dialog: null,
    pendingRange: null,
    isModerator: false,
    email: null,
    isAuthenticated: false,
  };

  // ---------- bubble (п.5 + верхнее позиционирование) ----------
  function showPopup(rect) {
    hidePopup();
    const el = document.createElement('div');
    el.className = 'dl-comment-popup';
    el.innerHTML = `
      <button type="button" class="dl-comment-popup__btn"
              title="${esc(ui.popupButton || 'Оставить комментарий')}"
              aria-label="${esc(ui.popupButton || 'Оставить комментарий')}">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M2.5 2h11a.5.5 0 0 1 .5.5v8a.5.5 0 0 1-.5.5H6l-3 3v-3H2.5a.5.5 0 0 1-.5-.5v-8a.5.5 0 0 1 .5-.5z" fill="currentColor"/>
        </svg>
      </button>`;
    const btn = el.querySelector('button');
    btn.addEventListener('mousedown', (e) => { e.preventDefault(); e.stopPropagation(); });
    btn.addEventListener('mouseup', (e) => { e.stopPropagation(); });
    btn.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      hidePopup();
      openDialog({});
    });
    document.body.appendChild(el);

    // Верх bubble: нижний край = верхний край выделения (28px — размер кнопки)
    const BUBBLE = 28;
    let top = rect.top - BUBBLE;
    if (top < 8) top = rect.bottom + 2;   // нет места сверху — прижимаем снизу
    // let left = rect.right - BUBBLE / 2;   // центр bubble по правому краю выделения
    let left = rect.right + 4; // в конце выделенного текста

    left = Math.max(8, Math.min(window.innerWidth - BUBBLE - 8, left));

    el.style.top = `${top}px`;
    el.style.left = `${left}px`;
    state.popup = el;
    setTimeout(() => document.addEventListener('mousedown', onDocMouseDown), 0);
  }
  function hidePopup() {
    if (state.popup) { state.popup.remove(); state.popup = null; }
    document.removeEventListener('mousedown', onDocMouseDown);
  }
  function onDocMouseDown(e) {
    if (state.popup && !state.popup.contains(e.target)) hidePopup();
  }
  function onMouseUp() {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed) return hidePopup();
    if (sel.toString().trim().length < 3) return hidePopup();
    const range = sel.getRangeAt(0);
    if (!getRoot().contains(range.commonAncestorContainer)) return hidePopup();
    state.pendingRange = range.cloneRange();
    showPopup(range.getBoundingClientRect());
  }

  // ---------- click → side panel ----------
  function onClickDocument(e) {
    if (e.button !== 0) return;
    if (e.target.closest('.dl-comment-panel, .dl-comment-dialog, .dl-comment-overlay, .dl-comment-popup')) return;
    if (e.target.closest('a, button, input, textarea, select, label')) return;

    const off = offsetFromPoint(e.clientX, e.clientY);
    if (off == null) return;
    const hits = state.segments.filter(s => s.start <= off && off < s.end);
    if (!hits.length) return;
    openPanel(hits);
  }

  function openPanel(hits) {
    const root = getRoot();
    const seg = hits[0];
    const range = rangeFromOffsets(root, seg.start, seg.end);
    if (!range) return;
    const rect = range.getBoundingClientRect();

    const ids = [];
    const seen = new Set();
    for (const h of hits) for (const id of h.threadIds) {
      if (!seen.has(id)) { seen.add(id); ids.push(id); }
    }
    openPanelForThreads(ids, rect);
  }

  function openPanelForThreads(ids, rect) {
    if (!ids.length) return;

    // Позиция: по rect, если он есть; иначе — к верху области просмотра
    const docTop = rect ? rect.top + window.scrollY : (window.scrollY + 100);

    closePanel();

    const panel = document.createElement('div');
    panel.className = 'dl-comment-panel';
    panel.style.position = 'absolute';
    panel.style.top = `${Math.max(20, docTop)}px`;
    panel.style.left = `${document.documentElement.clientWidth - PANEL_WIDTH - 20}px`;
    panel.style.width = `${PANEL_WIDTH}px`;

    const header = document.createElement('div');
    header.className = 'dl-comment-panel__header';
    header.innerHTML = `
    <span class="dl-comment-panel__title">${esc(ui.threadTitle || 'Комментарии')}</span>
    <button type="button" class="dl-comment-panel__close" aria-label="Закрыть">×</button>`;
    panel.appendChild(header);

    const body = document.createElement('div');
    body.className = 'dl-comment-panel__body';
    panel.appendChild(body);

    document.body.appendChild(panel);
    state.panel = panel;
    state.panelThreadIds = ids;

    header.querySelector('.dl-comment-panel__close').addEventListener('click', closePanel);

    rerenderPanel();
  }

  function closePanel() {
    if (state.panel) { state.panel.remove(); state.panel = null; }
    state.panelThreadIds = null;
  }

  function rerenderPanel() {
    if (!state.panel || !state.panelThreadIds) return;
    const threads = state.panelThreadIds
      .map(id => state.threads.find(t => t.id === id))
      .filter(Boolean);
    if (!threads.length) { closePanel(); return; }

    const titleEl = state.panel.querySelector('.dl-comment-panel__title');
    if (titleEl) titleEl.textContent = `${ui.threadTitle || 'Комментарии'} (${threads.length})`;

    const body = state.panel.querySelector('.dl-comment-panel__body');
    body.innerHTML = '';
    for (const t of threads) body.appendChild(renderPanelThread(t));
  }

  function renderPanelThread(t) {
    const wrap = document.createElement('div');
    wrap.className = 'dl-comment-panel__thread';

    const q = document.createElement('div');
    q.className = 'dl-comment-panel__quote';
    q.textContent = '«' + (t.anchor.quote || '') + '»';
    wrap.appendChild(q);

    const msgs = document.createElement('div');
    msgs.className = 'dl-comment-panel__messages';
    for (const c of t.comments) {
      const div = document.createElement('div');
      div.className = 'msg' + (c.is_moderator ? ' msg--mod' : '');
      const author = c.author_name || (c.is_moderator ? 'Технический писатель' : (ui.anonymous || 'Аноним'));
      div.innerHTML = `
        <div class="msg__meta"><b>${esc(author)}</b> · ${esc(new Date(c.created_at).toLocaleString())}</div>
        <div class="msg__body">${esc(c.body)}</div>`;
      msgs.appendChild(div);
    }
    wrap.appendChild(msgs);

    // Actions:
    //  open  + mod  → reply form (с resolve-checkbox)
    //  open  + reader → notice
    //  resolved + mod  → Переоткрыть + Архивировать (локально)
    //  resolved + reader → Архивировать (локально)
    if (t.status === 'open' && state.isModerator) {
      wrap.appendChild(renderModeratorReply(t));
    } else if (t.status === 'open' && !state.isModerator) {
      const notice = document.createElement('div');
      notice.className = 'dl-comment-panel__notice';
      notice.textContent = ui.replyUnavailable || 'Отвечать может только технический писатель.';
      wrap.appendChild(notice);
    } else if (t.status === 'resolved') {
      const actions = document.createElement('div');
      actions.className = 'dl-comment-panel__reply';
      const notice = document.createElement('div');
      notice.className = 'dl-comment-panel__notice';
      notice.textContent = ui.resolvedNotice || 'Тред разрешён. Новые ответы закрыты.';
      actions.appendChild(notice);

      const row = document.createElement('div');
      row.className = 'dl-comment-panel__actions';

      if (state.isModerator) {
        const reopen = document.createElement('button');
        reopen.type = 'button';
        reopen.className = 'dl-comment-panel__btn';
        reopen.textContent = 'Переоткрыть';
        reopen.addEventListener('click', () => onReopen(t, reopen, errEl));
        row.appendChild(reopen);
      }

      const arch = document.createElement('button');
      arch.type = 'button';
      arch.className = 'dl-comment-panel__btn dl-comment-panel__btn--ghost';
      arch.textContent = ui.archive || 'Архивировать';
      arch.title = 'Скрыть этот тред в этом браузере';
      arch.addEventListener('click', () => {
        hideThreadLocal(t.id);
        recompute();
        state.panelThreadIds = state.panelThreadIds.filter(id => id !== t.id);
        if (state.panelThreadIds.length === 0) closePanel();
        else rerenderPanel();
      });
      row.appendChild(arch);

      actions.appendChild(row);
      const errEl = document.createElement('div');
      errEl.className = 'dl-comment-panel__error';
      actions.appendChild(errEl);
      wrap.appendChild(actions);
    }

    return wrap;
  }

  function renderModeratorReply(t) {
    const box = document.createElement('div');
    box.className = 'dl-comment-panel__reply';
    box.innerHTML = `
      <textarea class="dl-comment-panel__textarea" placeholder="Ответить как технический писатель…" maxlength="4000"></textarea>
      <div class="dl-comment-panel__actions">
        <label class="dl-comment-panel__checkbox"><input type="checkbox" class="resolve-cb" checked> Разрешить после ответа</label>
        <button type="button" class="dl-comment-panel__btn dl-comment-panel__btn--primary submit-btn">Ответить</button>
      </div>
      <div class="dl-comment-panel__error"></div>`;

    const ta = box.querySelector('textarea');
    const cb = box.querySelector('.resolve-cb');
    const btn = box.querySelector('.submit-btn');
    const errEl = box.querySelector('.dl-comment-panel__error');

    btn.addEventListener('click', async () => {
      const text = ta.value.trim();
      if (!text) { errEl.textContent = 'Введите ответ.'; ta.focus(); return; }
      btn.disabled = true;
      try {
        const r1 = await fetch(`${API}/comments`, {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ thread_id: t.id, body: text }),
        });
        if (!r1.ok) throw new Error('HTTP ' + r1.status);
        if (cb.checked) {
          await fetch(`${API}/threads/${t.id}`, {
            method: 'PATCH', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: 'resolved' }),
          });
        }
        await loadThreads();
        rerenderPanel();            // ← НЕ закрываем (п.3)
      } catch (e) {
        errEl.textContent = 'Ошибка: ' + e.message;
        btn.disabled = false;
      }
    });

    return box;
  }

  async function onReopen(t, btn, errEl) {
    btn.disabled = true;
    try {
      await fetch(`${API}/threads/${t.id}`, {
        method: 'PATCH', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'open' }),
      });
      await loadThreads();
      rerenderPanel();              // ← НЕ закрываем (п.5)
    } catch (e) {
      if (errEl) errEl.textContent = 'Ошибка: ' + e.message;
      btn.disabled = false;
    }
  }

  // ---------- dialog (только для НОВОГО) ----------
  function resetDialogState() {
    if (state.dialog) { state.dialog.remove(); state.dialog = null; }
  }
  function closeDialog() { resetDialogState(); state.pendingRange = null; }

  function openDialog({ thread } = {}) {
    resetDialogState();
    if (thread) return;
    const quote = state.pendingRange ? state.pendingRange.toString() : '';

    const needAuth = !state.isAuthenticated && !state.isModerator;   // ← ЭТА СТРОКА

    const authBlock = needAuth ? `
    <input type="email" class="dl-comment-dialog__name dl-comment-dialog__email"
           placeholder="${esc(ui.emailPlaceholder || 'you@company.ru')}" maxlength="200" autocomplete="email">
    <input type="text" class="dl-comment-dialog__name dl-comment-dialog__code"
           placeholder="${esc(ui.claimCodePlaceholder || 'Код от администратора')}" maxlength="10" autocomplete="off">
  ` : '';

    const ov = document.createElement('div');
    ov.className = 'dl-comment-overlay';
    ov.innerHTML = `
    <div class="dl-comment-dialog" role="dialog" aria-modal="true">
      <div class="dl-comment-dialog__header">
        <span class="dl-comment-dialog__title">${esc(ui.threadTitle || 'Комментарии')}</span>
        <button type="button" class="dl-comment-dialog__close" aria-label="Закрыть">×</button>
      </div>
      <div class="dl-comment-dialog__quote">«${esc(quote)}»</div>
      <div class="dl-comment-dialog__compose">
        ${authBlock}                                                <!-- ← ЭТА ВСТАВКА -->
        <input type="text" class="dl-comment-dialog__name" placeholder="${esc(ui.namePlaceholder || '')}" maxlength="100">
        <textarea class="dl-comment-dialog__body" placeholder="${esc(ui.bodyPlaceholder || '')}" maxlength="4000"></textarea>
        <div class="dl-comment-dialog__actions">
          <button type="button" class="dl-comment-dialog__cancel">${esc(ui.cancel || 'Отменить')}</button>
          <button type="button" class="dl-comment-dialog__submit">${esc(ui.submit || 'Отправить')}</button>
        </div>
        <div class="dl-comment-dialog__error" role="alert"></div>
      </div>
    </div>`;
    document.body.appendChild(ov);

    const els = {
      ov,
      close: ov.querySelector('.dl-comment-dialog__close'),
      cancel: ov.querySelector('.dl-comment-dialog__cancel'),
      submit: ov.querySelector('.dl-comment-dialog__submit'),
      name: ov.querySelector('.dl-comment-dialog__name:not(.dl-comment-dialog__email):not(.dl-comment-dialog__code)'),
      email: ov.querySelector('.dl-comment-dialog__email'),
      code: ov.querySelector('.dl-comment-dialog__code'),
      body: ov.querySelector('.dl-comment-dialog__body'),
      error: ov.querySelector('.dl-comment-dialog__error'),
    };

    try { const saved = localStorage.getItem('dl-comment-name'); if (saved) els.name.value = saved; } catch { }

    els.submit.addEventListener('click', () => submitNew(els));
    els.close.addEventListener('click', closeDialog);
    els.cancel.addEventListener('click', closeDialog);
    ov.addEventListener('mousedown', (e) => { if (e.target === ov) closeDialog(); });

    if (els.email) els.email.focus();
    else els.body.focus();

    state.dialog = ov;
  }

  async function submitNew(els) {
    const body = els.body.value.trim();
    if (!body) { els.error.textContent = ui.errorEmpty || ''; els.body.focus(); return; }
    if (!state.pendingRange) { els.error.textContent = ui.errorGeneric || ''; return; }
    const anchor = buildAnchor(state.pendingRange);
    if (!anchor) { els.error.textContent = ui.errorGeneric || ''; return; }

    const name = els.name && els.name.value.trim() ? els.name.value.trim() : null;
    if (name) { try { localStorage.setItem('dl-comment-name', name); } catch { } }

    const payload = {
      page_path: location.pathname,
      anchor,
      author_name: name,
      body,
    };

    if (els.email) {
      const email = els.email.value.trim();
      if (!email) { els.error.textContent = ui.errEmailRequired || 'Введите email.'; els.email.focus(); return; }
      payload.email = email;
    }
    if (els.code) {
      const code = els.code.value.trim();
      if (!code) { els.error.textContent = ui.errCodeRequired || 'Введите код.'; els.code.focus(); return; }
      payload.claim_code = code;
    }

    const headers = { 'Content-Type': 'application/json' };
    const token = (() => { try { return localStorage.getItem('dl-comment-token'); } catch { return null; } })();
    if (token && state.isAuthenticated) headers['Authorization'] = `Bearer ${token}`;

    els.submit.disabled = true;
    els.submit.textContent = ui.submitting || 'Отправка…';
    els.error.textContent = '';

    try {
      const res = await fetch(`${API}/threads`, { method: 'POST', headers, body: JSON.stringify(payload) });

      if (res.status === 401) {
        try { localStorage.removeItem('dl-comment-token'); } catch { }
        state.isAuthenticated = false;
        state.email = null;
        els.error.textContent = ui.errUnauthorized || 'Сессия истекла. Введите email и код заново.';
        els.submit.disabled = false;
        els.submit.textContent = ui.submit || 'Отправить';
        // Перерисовать диалог с полями email+code
        setTimeout(() => { const r = state.pendingRange; closeDialog(); if (r) { state.pendingRange = r; openDialog({}); } }, 100);
        return;
      }
      if (res.status === 403) {
        const data = await res.json().catch(() => ({}));
        const map = {
          email_not_allowed: ui.errNotAllowed,
          banned: ui.errBanned,
          email_in_use: ui.errInUse,
          bad_code: ui.errBadCode,
          email_required: ui.errEmailRequired,
          claim_code_required: ui.errCodeRequired,
        };
        els.error.textContent = map[data.error] || ui.errorGeneric || '';
        els.submit.disabled = false;
        els.submit.textContent = ui.submit || 'Отправить';
        return;
      }
      if (res.status === 429) {
        els.error.textContent = ui.errRateLimit || 'Слишком много запросов.';
        els.submit.disabled = false;
        els.submit.textContent = ui.submit || 'Отправить';
        return;
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = await res.json();
      if (data.session_token) {
        try { localStorage.setItem('dl-comment-token', data.session_token); } catch { }
        state.isAuthenticated = true;
      }

      closeDialog();
      if (data.thread) {
        addThread(data.thread);
        const seg = state.segments.find(s => s.threadIds.includes(data.thread.id));
        let rect = null;
        if (seg) {
          const r = rangeFromOffsets(getRoot(), seg.start, seg.end);
          if (r) rect = r.getBoundingClientRect();
        }
        openPanelForThreads([data.thread.id], rect);
      }
    } catch (e) {
      console.error('[comments] submit failed:', e);
      els.error.textContent = ui.errorGeneric || '';
      els.submit.disabled = false;
      els.submit.textContent = ui.submit || 'Отправить';
    }
  }

  // ---------- highlights & segments ----------
  function addThread(t) { state.threads.push(t); recompute(); }

  function recompute() {
    const root = getRoot();
    const hidden = getHiddenSet();
    const positioned = [];
    for (const t of state.threads) {
      if (t.status === 'archived') continue;
      if (hidden.has(t.id)) continue;
      const pos = findAnchorPositions(root, t.anchor);
      if (!pos) {
        t._orphanChecks = (t._orphanChecks || 0) + 1;
        if (t._orphanChecks >= 3 && !t._orphanReported) {
          t._orphanReported = true;
          fetch(`${API}/threads/${t.id}/orphaned`, { method: 'POST' }).catch(() => { });
        }
        continue;
      }
      t._orphanChecks = 0;
      if (t.orphaned_at) {
        t.orphaned_at = null;
        fetch(`${API}/threads/${t.id}/orphaned`, { method: 'DELETE' }).catch(() => { });
      }
      t._start = pos.start; t._end = pos.end;
      positioned.push(t);
    }
    const points = new Set();
    for (const t of positioned) { points.add(t._start); points.add(t._end); }
    const sorted = [...points].sort((a, b) => a - b);
    const segs = [];
    for (let i = 0; i < sorted.length - 1; i++) {
      const a = sorted[i], b = sorted[i + 1];
      if (a === b) continue;
      const cover = positioned.filter(t => t._start <= a && b <= t._end);
      if (cover.length) segs.push({ start: a, end: b, threadIds: cover.map(t => t.id) });
    }
    state.segments = segs;
    renderHighlights();
  }

  function renderHighlights() {
    if (!('highlights' in CSS)) {
      console.warn('[comments] CSS Custom Highlight API недоступен в этом браузере — подсветка отключена.');
      return;
    }
    const root = getRoot();
    const openHl = new Highlight();
    const resolvedHl = new Highlight();
    for (const s of state.segments) {
      const r = rangeFromOffsets(root, s.start, s.end);
      if (!r) continue;
      const threads = s.threadIds.map(id => state.threads.find(t => t.id === id)).filter(Boolean);
      const hasOpen = threads.some(t => t.status === 'open');
      (hasOpen ? openHl : resolvedHl).add(r);
    }
    CSS.highlights.set('dl-comment-anchor', openHl);
    CSS.highlights.set('dl-comment-anchor-resolved', resolvedHl);
  }

  // ---------- boot ----------
  async function loadThreads() {
    try {
      const url = `${API}/threads?page_path=${encodeURIComponent(location.pathname)}`;
      const res = await fetch(url, { credentials: 'include' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      state.threads = data.threads || [];
      state.isModerator = !!data.isModerator;
      recompute();
    } catch (e) {
      console.warn('[comments] load failed:', e);
    }
  }
  async function checkAuth() {
    const token = (() => { try { return localStorage.getItem('dl-comment-token'); } catch { return null; } })();
    if (!token) { state.isAuthenticated = false; state.email = null; return; }
    try {
      const res = await fetch(`${API}/auth/me`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) {
        try { localStorage.removeItem('dl-comment-token'); } catch { }
        state.isAuthenticated = false;
        state.email = null;
        return;
      }
      const data = await res.json();
      state.isAuthenticated = true;
      state.email = data.email;
    } catch {
      state.isAuthenticated = false;
      state.email = null;
    }
  }

  function boot() {
    if (!findArticleBody()) { setTimeout(boot, 200); return; }
    checkAuth().then(() => loadThreads());
    setTimeout(recompute, 2000);
    setTimeout(recompute, 4000);
    document.addEventListener('mouseup', onMouseUp);
    document.addEventListener('click', onClickDocument);
    window.addEventListener('popstate', () => setTimeout(loadThreads, 100));
    window.addEventListener('focus', () => loadThreads());
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') loadThreads();
    });
    window.addEventListener('resize', () => {
      if (state.panel) {
        state.panel.style.left = `${document.documentElement.clientWidth - PANEL_WIDTH - 20}px`;
      }
    });
    setInterval(loadThreads, 15_000);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();