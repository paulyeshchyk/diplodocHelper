[data-feature-map] { 
  font-size: 0.9em; 
  
  /* ==========================================
     БРЕНДИРОВАНИЕ — «Свежий болото»
     ========================================== */
  --brand-color: #6B8E23;        /* основной оливковый акцент */
  --brand-deep:  #4A5D23;        /* глубокий болотный — шапка и заголовки */
  --brand-tint:  #F0F5E6;        /* мягкий светлый фон */
  --brand-on-dark: #FFFFFF;      /* контрастный белый текст */
  
  /* Дополнительные оттенки для таблицы */
  --brand-border: #C5D4A3;       /* рамки и разделители */
  --brand-cell-bg: #F7FAF0;      /* фон ячеек */
  --brand-chip-bg: var(--brand-color); /* По умолчанию фон fm-chip базовый (#6B8E23) */

  /* ==========================================
     НАСТРОЙКИ ВНЕШНЕГО ВИДА ТАБЛИЦЫ
     ========================================== */
  --fm-cell-padding: 1px; 
  --fm-chip-gap: 1px;     
  --fm-first-col-width: 180px; 
}

/* ---- полосы фильтров ---- */
.fm-strip {
  display: flex; gap: 6px; align-items: center;
  flex-wrap: wrap;
  padding: 6px 0; margin: 4px 0;
  border-bottom: 1px solid var(--brand-border);
}
.fm-strip-label {
  font-weight: 600; color: var(--brand-deep);
  padding-right: 8px; flex-shrink: 0; min-width: 80px;
}
.fm-strip-item {
  display: inline-flex; align-items: center; gap: 2px;
  margin-right: 4px;
}
.fm-strip-link {
  font-size: 0.75em; color: var(--brand-color) !important;
  text-decoration: none !important;
  padding: 0 3px; line-height: 1;
  opacity: 0.75;
}
.fm-strip-link:hover { opacity: 1; }

/* ---- чипы фильтров (верхние) ---- */
.fm-chip {
  display: inline-block;
  padding: 4px 10px; 
  border-radius: 4px; 
  background: var(--brand-chip-bg); 
  color: var(--brand-on-dark) !important; /* Белый контрастный текст по умолчанию */
  border: 1px solid var(--brand-color);
  text-decoration: none !important;
  font-size: 0.85em; line-height: 1.2;
  cursor: pointer; white-space: nowrap;
  font-family: inherit;
  transition: background .15s, opacity .15s, box-shadow .15s, border-color .15s;
  text-align: center;
  overflow: hidden;
}
.fm-chip small { opacity: .85; margin-left: 4px; font-size: .9em; }

.fm-chip.is-active {
  background: #3B4E16 !important; /* Насыщенный темно-оливковый оттенок */
  color: var(--brand-on-dark) !important;
  border-color: #3B4E16 !important;
  box-shadow: none !important;
}
.fm-chip.is-active small { opacity: .95; }
.fm-chip.is-peer {
  outline: 2px solid #558B2F; outline-offset: 1px;
}

/* Выделенный (highlighted) чип — ярче и насыщеннее базового цвета */
.fm-chip.is-highlight {
  background: #558B2F !important; /* Яркий сочный оливково-зеленый */
  color: var(--brand-on-dark) !important;
  border-color: #7CB342 !important;
  box-shadow: 0 0 6px rgba(85, 139, 47, 0.5);
}
.fm-chip.is-dimmed { opacity: .15 !important; }

/* Верхние чипы фильтров в полосе fm-strip (пастельный стиль в неактивном состоянии) */
.fm-strip .fm-chip {
  background: var(--brand-tint);
  color: var(--brand-deep) !important;
  border-color: var(--brand-border);
}
.fm-strip .fm-chip.is-active {
  background: var(--brand-color) !important;
  color: var(--brand-on-dark) !important;
  border-color: var(--brand-color) !important;
}

/* ---- тулбар ---- */
.fm-toolbar {
  display: flex; align-items: center; gap: 12px;
  margin: 8px 0; padding: 6px 0;
  border-top: 1px solid var(--brand-border);
  border-bottom: 1px solid var(--brand-border);
}
.fm-counter {
  font-size: 0.9em; color: var(--brand-deep);
  font-variant-numeric: tabular-nums;
}
.fm-reset-all {
  margin-left: auto;
  padding: 4px 10px;
  border: 1px solid var(--brand-border); border-radius: 4px;
  background: var(--brand-tint); 
  color: var(--brand-deep);
  cursor: pointer;
  font-size: 0.85em; font-family: inherit;
  transition: all .15s;
}
.fm-reset-all:hover:not(:disabled) { 
  background: var(--brand-color); 
  color: var(--brand-on-dark);
  border-color: var(--brand-color);
}
.fm-reset-all:disabled { opacity: .4; cursor: default; }

/* ---- Сетка (Таблица) ---- */
.fm-grid {
  table-layout: fixed;
  width: 100% !important;
  max-width: 100% !important;
  display: table !important;
  margin-top: 8px;
  border-collapse: collapse;
  font-size: .85em;
}

.fm-grid th:first-child,
.fm-grid td:first-child {
  width: var(--fm-first-col-width);
}

/* Ячейки */
.fm-grid th, .fm-grid td {
  border: 1px solid var(--brand-border);
  padding: 0 !important;
  min-width: 0 !important; 
  vertical-align: middle; 
  text-align: center;     
  background: var(--brand-cell-bg);
  overflow: hidden;
  box-sizing: border-box;
  transition: background .15s, opacity .15s;
}

.fm-grid tbody tr {
  height: var(--fm-row-height, 100px);
}

/* Шапка таблицы */
.fm-grid thead th {
  background: linear-gradient(
    180deg,
    var(--brand-deep) 0%,
    color-mix(in srgb, var(--brand-deep) 85%, black) 100%
  );
  color: var(--brand-on-dark);
  font-weight: 500;
  position: sticky;
  top: 0;
  z-index: 1;
  height: 44px; 
  padding: 0 !important;
}

/* Строковые заголовки */
.fm-grid tbody th {
  background: var(--brand-tint); 
  color: var(--brand-deep);
  font-weight: 600;
  white-space: nowrap;
}

/* Контейнер внутри ячейки */
.fm-cell-content {
  display: grid;
  grid-template-columns: repeat(var(--fm-cell-cols, 1), minmax(0, 1fr));
  grid-auto-rows: minmax(0, 1fr);
  padding: var(--fm-cell-padding); 
  gap: var(--fm-chip-gap);        
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* Пустые ячейки */
.fm-grid td.is-empty .fm-cell-content {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5em;
  color: var(--brand-border);
}

/* ---- Чипы модулей внутри сетки ---- */
.fm-grid td .fm-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0 4px;
  border-radius: 3px;
  font-size: 0.8em;
  text-align: center;
  
  background: var(--brand-chip-bg);
  color: var(--brand-on-dark) !important; /* Белый текст на базовом оливковом фоне */
  border: none;
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand-deep) 30%, transparent); 
  
  white-space: nowrap;     
  overflow: hidden;        
  text-overflow: ellipsis; 
}

/* Подсветка ячеек */
.fm-grid td.is-highlight { background: #EDEFE0; }

/* ---- Шапки (кнопки) ---- */
.fm-hdr {
  position: relative;
  width: 100%;
  height: 100%;
}

.fm-hdr-btn {
  display: flex;      
  align-items: center;
  justify-content: center; 
  width: 100%;
  height: 100%;       
  padding: 0 18px 0 8px; 
  background: transparent;
  border: none;
  font: inherit;
  color: inherit;
  cursor: pointer;
  user-select: none;
  transition: background .15s, color .15s;
  font-family: inherit;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fm-grid tbody th .fm-hdr-btn {
  justify-content: flex-start;
  text-align: left;
}

/* Hover / active */
.fm-grid thead .fm-hdr-btn:hover { background: rgba(255, 255, 255, 0.12); }
.fm-grid thead .fm-hdr-btn.is-active { background: var(--brand-color); color: #fff; }

.fm-grid tbody .fm-hdr-btn:hover { background: color-mix(in srgb, var(--brand-color) 12%, transparent); }
.fm-grid tbody .fm-hdr-btn.is-active { background: var(--brand-color); color: #fff; }

.fm-hdr-btn:focus { outline: 2px solid var(--brand-color); outline-offset: -2px; }
.fm-hdr-btn.is-peer   { outline: 2px solid var(--brand-color); outline-offset: -2px; }

.fm-hdr-link {
  position: absolute; 
  top: 50%;
  transform: translateY(-50%);
  right: 4px;
  font-size: 0.85em; 
  color: var(--brand-color) !important;
  text-decoration: none !important;
  padding: 2px; 
  line-height: 1;
  opacity: 0.6;
  z-index: 2;
}
.fm-hdr-link:hover { opacity: 1; }

.fm-grid thead .fm-hdr-link { color: var(--brand-on-dark) !important; }

/* ==========================================
   СОСТОЯНИЯ ПРИ ФИЛЬТРАЦИИ
   ========================================== */

/* 1. Отфильтрованные ячейки */
.fm-grid td.is-dimmed {
  background: #F4F6EE !important; 
  opacity: 1 !important;
}
.fm-grid td.is-dimmed .fm-cell-content {
  opacity: 0.05 !important;
  filter: grayscale(1);
}

/* 2. Ячейка-превью */
.fm-grid td.is-cell-preview-add {
  background: #F8F9F3 !important;
}

/* 3. Подсвеченный чип (МОДУЛЬ ОСТАЕТСЯ) — сочный яркий оливково-зеленый */
.fm-grid td .fm-chip.is-highlight {
  background: #558B2F !important;
  color: var(--brand-on-dark) !important;
  border: none !important;
  box-shadow: 0 0 4px rgba(85, 139, 47, 0.5) !important;
  opacity: 1 !important;
}

/* 4. Чип, который добавится при клике */
.fm-grid td .fm-chip.is-preview-add {
  background: transparent !important;
  color: var(--brand-color) !important;
  border: 1.5px dashed var(--brand-color) !important;
  box-shadow: none !important;
}

/* 5. Чип, который исчезнет при клике */
.fm-grid td .fm-chip.is-preview-drop {
  background: transparent !important;
  color: #999 !important;
  border: 1px dashed #CCC !important;
  box-shadow: none !important;
  opacity: 0.4;
}

/* 6. Отфильтрованные чипы */
.fm-grid td .fm-chip.is-dimmed {
  opacity: 0.15 !important;
}

/* Общий цвет рамок таблицы */
.fm-grid table,
.fm-grid td,
.fm-grid th,
.fm-grid tr {
  border-color: #E2ECC9 !important;
}

/* ==========================================
   ПОДСВЕТКА ЯЧЕЙКИ ПРИ НАВЕДЕНИИ (HOVER)
   ========================================== */

/* 1. Плавный переход фона ячейки */
.fm-grid td {
  transition: background-color .15s ease-in-out, opacity .15s;
}

/* 2. Подсветка ячейки при наведении на саму ячейку или на чип внутри нее */
.fm-grid td:hover,
.fm-grid td:has(.fm-chip:hover) {
  /* Мягкая подложка с использованием акцентного цвета */
  background-color: color-mix(in srgb, var(--brand-color) 15%, var(--brand-cell-bg)) !important;
  cursor: pointer;
}

/* 3. Небольшое усиление/акцент для самого чипа при ховере */
.fm-grid td .fm-chip:hover {
  filter: brightness(1.1);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
  transform: translateY(-1px);
}