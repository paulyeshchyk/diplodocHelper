{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Production (VSIX)",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Release: Increment Patch",
      "type": "shell",
      "command": "npm run release:patch",
      "group": "build",
      "presentation": {
        "clear": true,
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "Release: Increment Minor",
      "type": "shell",
      "command": "npm run release:minor",
      "group": "build",
      "presentation": {
        "clear": true,
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "Check: Types",
      "type": "shell",
      "command": "npm run type-check",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Watch (for Debugging)",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*",
          "endsPattern": "^.*"
        }
      },
      "presentation": {
        "clear": true,
        "reveal": "never",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "Prepare Debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Check: Types",
        "Watch (for Debugging)"
      ]
    }
  ]
}