{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "ES2020",
        "module": "commonjs",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.js",
        "src/**/*.ts",
        "global.d.ts",
        "src/plugins/utils/yaml-inline/value-context.js_",
        "src/plugins/utils/yaml-inline/utils.js_",
        "src/plugins/utils/yaml-inline/tag-guard.js_",
        "src/plugins/utils/yaml-inline/key-line.js_",
        "src/plugins/utils/yaml-inline/index.test.js_",
        "src/plugins/utils/yaml-inline/index.js_"
    ],
    "exclude": [
        "**/*breadcrumb.template.js",
        "**/*.test.js",
        "**/*.test.ts",
        "**/contentNavigator/**"
    ]
}