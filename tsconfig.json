{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "ES2020",
        "module": "commonjs",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*",
        "global.d.ts",
        "scripts/copy-assets.js"
    ],
    "exclude": [
        "node_modules",
        "**//dist/**",
        "coverage",
        "**/*.template.js",
        "**/assets/**",
        "**/*.test.ts"
    ]
}