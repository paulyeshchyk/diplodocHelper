{
  "compilerOptions": {
    "module": "CommonJS",
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "checkJs": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "src/extension.js",
    "global.d.ts",
    "scripts/generate-contrib.js"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/plugins/breadcrumb/breadcrumb.template.js"
  ]
}