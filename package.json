{
  "name": "diplodochelper",
  "publisher": "paulyestchick",
  "displayName": "diplodoc-helper",
  "description": "",
  "version": "0.6.0",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "diplodoc-helper.createSection",
        "title": "Создать рубрику"
      },
      {
        "command": "diplodoc-helper.deleteSection",
        "title": "Удалить рубрику"
      },
      {
        "command": "diplodoc-helper.renameSection",
        "title": "Задать новый тип и наименование"
      },
      {
        "command": "diplodoc-helper.reindex",
        "title": "Переиндексировать всё"
      },
      {
        "command": "diplodoc-helper.copyLink",
        "title": "Копировать ссылку на документ"
      },
      {
        "command": "diplodoc-helper.pasteLink",
        "title": "Вставить ссылку на документ"
      }
    ],
    "submenus": [
      {
        "id": "diplodoc.menu",
        "label": "Diplodoc"
      },
      {
        "id": "diplodoc.menu_editor",
        "label": "Diplodoc"
      }
    ],
    "menus": {
      
      "editor/context": [
        {
          "submenu": "diplodoc.menu_editor",
          "when": "editorTextFocus && !editorReadonly",
          "group": "7_diplodoc_group@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "diplodoc.menu",
          "group": "7_diplodoc_group@1"
        }
      ],
      "diplodoc.menu_editor": [
        {
          "command": "diplodoc-helper.pasteLink",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_main0@1"
        }
      ],
      "diplodoc.menu": [
        {
          "command": "diplodoc-helper.copyLink",
          "when": "explorerResourceIsFolder || resourceExtname == .md || resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .svg",
          "group": "1_main0@1"
        },
        {
          "command": "diplodoc-helper.createSection",
          "when": "explorerResourceIsFolder",
          "group": "1_main@1"
        },
        {
          "command": "diplodoc-helper.deleteSection",
          "when": "explorerResourceIsFolder",
          "group": "1_main@2"
        },
        {
          "command": "diplodoc-helper.renameSection",
          "when": "explorerResourceIsFolder",
          "group": "1_main@3"
        },
        {
          "command": "diplodoc-helper.reindex",
          "when": "explorerResourceIsFolder",
          "group": "1_main1@1"
        }
      ]
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}