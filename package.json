{
  "name": "diplodochelper",
  "publisher": "paulyestchick",
  "displayName": "diplodoc-helper",
  "description": "",
  "repository": {
    "url": "https://github.com/paulyeshchyk/diplodocHelper"
  },
  "version": "0.10.39",
  "main": "./src/extension.js",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "diplodoc-helper.createSection",
        "title": "Создать рубрику"
      },
      {
        "command": "diplodoc-helper.deleteSection",
        "title": "Удалить рубрику"
      },
      {
        "command": "diplodoc-helper.renameSection",
        "title": "Задать новый тип и наименование"
      },
      {
        "command": "diplodoc-helper.moveSection",
        "title": "Переместить рубрику"
      },
      {
        "command": "diplodoc-helper.reindex",
        "title": "Переиндексировать всё"
      },
      {
        "command": "diplodoc-helper.copyLink",
        "title": "Копировать ссылку на документ"
      },
      {
        "command": "diplodoc-helper.pasteLink",
        "title": "Вставить ссылку на документ"
      },
      {
        "command": "diplodoc-helper.generateContexts",
        "title": "Сформировать контексты"
      },
      {
        "command": "diplodoc-helper.wipeEmptyDirectories",
        "title": "Удалить пустые папки после переиндексации"
      },
      {
        "command": "diplodoc-helper.generateHelpMaps",
        "title": "Сформировать навигационную карту для фронтэнд"
      },
      {
        "command": "diplodoc-helper.generateBreadcrumbs",
        "title": "Сформировать 'хлебные крошки'"
      }
    ],
    "submenus": [
      {
        "id": "diplodoc.explorer.context.menu",
        "label": "Diplodoc"
      },
      {
        "id": "diplodoc.editor.context.menu",
        "label": "Diplodoc"
      },
      {
        "id": "diplodoc.generators.explorer.context.menu",
        "label": "Прочее"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "diplodoc.editor.context.menu",
          "when": "editorTextFocus && !editorReadonly",
          "group": "diplodoc.menu@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "diplodoc.explorer.context.menu",
          "group": "diplodoc.menu@1"
        }
      ],
      "diplodoc.editor.context.menu": [
        {
          "command": "diplodoc-helper.pasteLink",
          "when": "editorTextFocus && !editorReadonly",
          "group": "diplodoc.section@1"
        }
      ],
      "diplodoc.explorer.context.menu": [
        {
          "command": "diplodoc-helper.createSection",
          "when": "explorerResourceIsFolder",
          "group": "1.diplodoc.section@1"
        },
        {
          "command": "diplodoc-helper.deleteSection",
          "when": "explorerResourceIsFolder",
          "group": "1.diplodoc.section@2"
        },
        {
          "command": "diplodoc-helper.renameSection",
          "when": "explorerResourceIsFolder",
          "group": "1.diplodoc.section@3"
        },
        {
          "command": "diplodoc-helper.moveSection",
          "when": "explorerResourceIsFolder",
          "group": "1.diplodoc.section@4"
        },
        {
          "command": "diplodoc-helper.copyLink",
          "when": "explorerResourceIsFolder || resourceExtname == .md || resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .svg",
          "group": "2.diplodoc.copy@1"
        },
        {
          "submenu": "diplodoc.generators.explorer.context.menu",
          "when": "explorerResourceIsFolder",
          "group": "3.diplodoc.generators@1"
        }
      ],
      "diplodoc.generators.explorer.context.menu": [
        {
          "command": "diplodoc-helper.reindex",
          "when": "explorerResourceIsFolder",
          "group": "1diplodoc.generators.section.command@1"
        },
        {
          "command": "diplodoc-helper.generateContexts",
          "when": "explorerResourceIsFolder",
          "group": "1diplodoc.generators.section.command@2"
        },
        {
          "command": "diplodoc-helper.generateHelpMaps",
          "when": "explorerResourceIsFolder",
          "group": "1diplodoc.generators.section.command@3"
        },
        {
          "command": "diplodoc-helper.generateBreadcrumbs",
          "when": "explorerResourceIsFolder",
          "group": "1diplodoc.generators.section.command@4"
        },
        {
          "command": "diplodoc-helper.wipeEmptyDirectories",
          "when": "explorerResourceIsFolder",
          "group": "99diplodoc.generators.files.command@1"
        }
      ]
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "echo 'No compilation needed for JS'",
    "package": "vsce package",
    "publish-vsix": "vsce publish",
    "publish-npm": "npm publish"
  }
}