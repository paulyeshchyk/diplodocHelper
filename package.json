{
  "name": "diplodochelper",
  "publisher": "paulyestchick",
  "displayName": "diplodoc-helper",
  "description": "",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:diplodoc-helper.createSection",
    "onCommand:diplodoc-helper.deleteSection",
    "onCommand:diplodoc-helper.generateContexts",
    "onCommand:diplodoc-helper.runGeneration"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "diplodoc-helper.createSection",
        "title": "Создать подраздел"
      },
      {
        "command": "diplodoc-helper.deleteSection",
        "title": "Удалить раздел"
      }
    ],
    "submenus": [
      {
        "id": "diplodoc.menu",
        "label": "Diplodoc"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "diplodoc.menu",
          "when": "explorerResourceIsFolder",
          "group": "7_diplodoc_group@1"
        }
      ],
      "diplodoc.menu": [
        {
          "command": "diplodoc-helper.createSection",
          "when": "explorerResourceIsFolder",
          "group": "1_main@1"
        },
        {
          "command": "diplodoc-helper.deleteSection",
          "when": "explorerResourceIsFolder",
          "group": "1_main@2"
        }
      ]
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}