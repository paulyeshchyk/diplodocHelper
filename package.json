{
  "name": "diplodochelper",
  "publisher": "paulyestchick",
  "displayName": "diplodoc-helper",
  "description": "",
  "version": "0.5.32",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "diplodoc-helper.createSection",
        "title": "Создать рубрику"
      },
      {
        "command": "diplodoc-helper.deleteSection",
        "title": "Удалить рубрику"
      },
      {
        "command": "diplodoc-helper.renameSection",
        "title": "Задать новый тип и наименование"
      },
      {
        "command": "diplodoc-helper.reindex",
        "title": "Переиндексировать всё"
      }
    ],
    "submenus": [
      {
        "id": "diplodoc.menu",
        "label": "Diplodoc"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "diplodoc.menu",
          "when": "explorerResourceIsFolder",
          "group": "7_diplodoc_group@1"
        }
      ],
      "diplodoc.menu": [
        {
          "command": "diplodoc-helper.createSection",
          "when": "explorerResourceIsFolder",
          "group": "1_main@1"
        },
        {
          "command": "diplodoc-helper.deleteSection",
          "when": "explorerResourceIsFolder",
          "group": "1_main@2"
        },
        {
          "command": "diplodoc-helper.renameSection",
          "when": "explorerResourceIsFolder",
          "group": "1_main@3"
        },
        {
          "command": "diplodoc-helper.reindex",
          "when": "explorerResourceIsFolder",
          "group": "1_main1@1"
        }
      ]
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}