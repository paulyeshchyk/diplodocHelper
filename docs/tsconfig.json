{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "ES2020",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.js",
        "src/**/*.ts",
        "global.d.ts"
    ],
    "exclude": [
        "**/*breadcrumb.template.js",
        "**/*.test.js",
        "**/*.test.ts",
        "**/contentNavigator/**"
    ]
}